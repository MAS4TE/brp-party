# Copy to .env in the repository root and fill in (loaded via python-dotenv).

# HTTP Basic Auth password for buyers and sellers
# (POST /power_request, GET /power_request, POST /actual_schedule)
POWER_REQUEST_PASSWORD=change-me

# HTTP Basic Auth password of ASSUME, username "assume" (POST /market_results)
# must differ from POWER_REQUEST_PASSWORD, otherwise every agent can send market results
MARKET_RESULTS_PASSWORD=change-me-too

# SQLite database file
DB_PATH=database.db
